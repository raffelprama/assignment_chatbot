# Gemini API key (Google AI Studio). The free tier is enough to run the PoC; see README "Quotas".
API_KEY=

# Qdrant — option A: a Qdrant Cloud cluster (URL or host name) + API key
QDRANT_CLUSTER=
QDRANT_API_KEY=

# Qdrant — option B: no server at all, embedded Qdrant on disk (leave QDRANT_CLUSTER empty)
# QDRANT_LOCAL_PATH=./qdrant_storage
# Qdrant — option C: `docker compose up -d`, then QDRANT_CLUSTER=http://localhost:6333

# Optional overrides
# MODEL_ANSWER=gemini-3.5-flash-lite
# MODEL_FAST=gemini-3.5-flash-lite
# MODEL_FALLBACKS=["gemini-3.6-flash","gemini-3.1-flash-lite"]
# TOP_K=3
# JUDGE_ENABLED=true
# SERVICE_API_KEY=            # if set, /api/v1/* requires header X-API-Key
