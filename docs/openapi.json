  "components": {
    "schemas": {
      "Body_upload_document_api_v1_rag_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_api_v1_rag_documents_post"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question"
          },
          "top_k": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "partial",
              "no_answer",
              "out_of_scope",
              "unsafe"
            ],
            "title": "Status"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "missing": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Missing"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "search_query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Query"
          },
          "judge": {
            "type": "string",
            "title": "Judge"
          },
          "retrieved": {
            "items": {
              "$ref": "#/components/schemas/Retrieved"
            },
            "type": "array",
            "title": "Retrieved"
          },
          "route": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Route"
          },
          "usage": {
            "additionalProperties": true,
            "type": "object",
            "title": "Usage"
          },
          "timings_ms": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Timings Ms"
          }
        },
        "type": "object",
        "required": [
          "trace_id",
          "question",
          "status",
          "answer",
          "citations",
          "missing",
          "language",
          "intent",
          "search_query",
          "judge",
          "retrieved",
          "route",
          "usage",
          "timings_ms"
        ],
        "title": "ChatResponse"
      },
      "Citation": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "doc_title": {
            "type": "string",
            "title": "Doc Title"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "pages": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Pages"
          },
          "section_no": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section No"
          },
          "section_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Title"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "doc_id",
          "doc_title",
          "file_name",
          "pages",
          "section_no",
          "section_title",
          "quote"
        ],
        "title": "Citation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobAccepted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "processing"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "doc_id"
        ],
        "title": "JobAccepted"
      },
      "KeyCreate": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "section_no": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Section No"
          },
          "text": {
            "type": "string",
            "maxLength": 300,
            "minLength": 3,
            "title": "Text"
          },
          "lang": {
            "type": "string",
            "maxLength": 5,
            "title": "Lang",
            "default": "id"
          }
        },
        "type": "object",
        "required": [
          "doc_id",
          "section_no",
          "text"
        ],
        "title": "KeyCreate"
      },
      "Retrieved": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "dense_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dense Rank"
          },
          "sparse_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sparse Rank"
          },
          "best_dense_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Best Dense Score"
          },
          "matched_via": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Via"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "score",
          "dense_rank",
          "sparse_rank",
          "best_dense_score",
          "matched_via"
        ],
        "title": "Retrieved"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "mode": {
            "type": "string",
            "enum": [
              "hybrid",
              "dense",
              "sparse"
            ],
            "title": "Mode",
            "default": "hybrid"
          }
        },
        "type": "object",
        "required": [
