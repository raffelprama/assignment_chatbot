    "/api/v1/main/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Main Chat",
        "description": "Answer a question from the SOP documents, with checked citations.\n\n`status` is a domain outcome (answered / partial / no_answer / out_of_scope / unsafe) and is\nalways returned with HTTP 200. A failing dependency (LLM, embeddings, Qdrant) returns 503.",
        "operationId": "main_chat_api_v1_main_chat_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
